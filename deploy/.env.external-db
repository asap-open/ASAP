# ── Database connection ────────────────────────────────────────────────────────
# Full PostgreSQL connection string pointing to your externally hosted database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://user:password@your-db-host:5432/asap?schema=public

# ── Server ─────────────────────────────────────────────────────────────────────
# Port exposed on the host for the API server
SERVER_PORT=3000

# Secret used to sign JWTs – use a long, random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# How long JWT tokens remain valid (e.g. 7d, 24h, 60m)
TOKEN_EXP=7d

# Origin(s) the server will accept requests from (comma-separated if needed).
# Example: http://localhost or https://asap.example.com
FRONTEND_DOMAIN=http://localhost

# ── Client ─────────────────────────────────────────────────────────────────────
# Port exposed on the host for the web client
CLIENT_PORT=80

# Public domain or IP where the app is accessible (comma-separated if needed).
# Example: localhost or app.example.com
DOMAIN_NAME=localhost

# URL where Nginx (inside the client container) can reach the backend API server.
# This is an INTERNAL network address — Nginx proxies all /api requests here at runtime.
# The compiled JS always uses a relative /api path and never contains this URL.
# Use the Docker service name (internal network), NOT a public hostname.
# Example: http://server:3000  (Docker Compose)  |  http://asap-server:3000  (Kubernetes)
VITE_BACKEND_SERVER_URL=http://server:3000
